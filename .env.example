# --- Server secrets (set as Cloudflare Worker secrets; never commit real values) ---
# Telegram: bot token from @BotFather and the chat that receives leads
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email copies of leads via Resend (https://resend.com); FROM must be on a verified domain
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# amoCRM: account subdomain (example.amocrm.ru) and a long-lived integration token
AMO_DOMAIN=
AMO_TOKEN=
# Optional: amoCRM pipeline id for new leads (default pipeline when empty)
AMO_PIPELINE_ID=

# --- Public settings (baked into the site at build time) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_ADS_LEAD_LABEL=
NEXT_PUBLIC_BOOKING_URL=
